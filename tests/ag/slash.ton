# Slash komutlari: kayit + secenek okuma + cevap bicimleri
use jubb

jubb.giris("SAHTE_TOKEN")
jubb.ag_ayarla(adres: env("SAHTE_GATEWAY"))
jubb.ayarla(temel: env("SAHTE_REST"))

KOMUTLAR = [
  jubb.komut("selam", "Selam verir"),
  jubb.komut("topla", "Toplar", [
    {ad: "bir", aciklama: "Birinci", tur: "sayi", zorunlu: true},
    {ad: "iki", aciklama: "Ikinci", tur: "sayi", zorunlu: true}
  ]),
  jubb.komut("yanki", "Geri soyler", [
    {ad: "metin", aciklama: "Yazi", tur: "metin", zorunlu: true}
  ])
]

func hazir(veri)
  print: HAZIR: %veri.user.username% / uygulama %(jubb.ayar().uygulama)%
  jubb.komutlari_ayarla(%KOMUTLAR%, 7)
  print: %(len(%KOMUTLAR%))% komut kaydedildi
end

func slash(e)
  ad = jubb.komut_adi(%e%)
  kisi = jubb.kim(%e%)
  print: /%ad% <- %kisi.username%

  if %ad% == "selam"
    jubb.cevapla(%e%, "Selam " + jubb.bahset(%kisi.id%) + "!")
  elif %ad% == "topla"
    bir = jubb.secenek(%e%, "bir", 0)
    iki = jubb.secenek(%e%, "iki", 0)
    jubb.cevapla(%e%, %bir% + " + " + %iki% + " = " + (%bir% + %iki%))
  elif %ad% == "yanki"
    jubb.cevapla(%e%, {baslik: "Yanki", aciklama: jubb.secenek(%e%, "metin", ""),
                       renk: "#2f6fed"})
  else
    jubb.cevapla(%e%, "bilmiyorum", gizli: true)
  end
  return null
end

func katildi(veri)
  print: bot duruyor
  jubb.dur()
end

jubb.dinle("hazir", hazir)
jubb.dinle("komut", slash)
jubb.dinle("uye_katildi", katildi)

jubb.calistir(["sunucular"], yeniden_baglan: false)
print: bitti
