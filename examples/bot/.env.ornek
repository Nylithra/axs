# Bu dosyayi `.env` adiyla kopyala ve kendi degerlerini yaz:
#   cp .env.ornek .env

JUBB_TOKEN=buraya_bot_tokenini_yaz

# Slash komutlarinin HEMEN gorunmesi icin sunucu kimligin
JUBB_SUNUCU=sunucu_kimligin

# Uygulama kimligi baglantida kendiliginden gelir; gelmezse yaz:
# JUBB_UYGULAMA=uygulama_kimligin

# Veritabani dosyasi (varsayilan: ton.db)
# TON_VERI=ton.db

# Baglanti adimlarini ekrana yazsin
# TON_KAYIT=1

# Kendi sunucuna baglanmak istersen:
# JUBB_TEMEL=https://gateway.jubbio.com/api/v1
# JUBB_GATEWAY=wss://realtime.jubbio.com/ws/bot
