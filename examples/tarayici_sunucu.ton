# Tarayici tarafi + sunucu birlikte.
#   ton examples/tarayici_sunucu.ton   ->  http://localhost:8080

use web

# Sunucudaki veri
notlar = ["TON'u dene", "tonweb ile site yap"]

func liste(istek)
  return %notlar%
end

func yeni_not(istek)
  metin = %istek.veri.metin%
  if %metin%
    ekle(%notlar%, %metin%)
  end
  return %notlar%
end

web.api("/api/notlar", liste)
web.post("/api/ekle", yeni_not)

# Tarayicida calisan TON uygulamasi
web.uygulama("/", "tarayici/yapilacaklar.ton", baslik: "TON Yapilacaklar")

web.serve(8080)
